<Window x:Class="GameEngine2D.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameEngine2D"
        mc:Ignorable="d"
        Title="2D Game Engine" Height="900" Width="1500" 
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize">

    <Window.Resources>
        <!-- Dark modern TextBox style -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0098FF"/>
                                <Setter TargetName="border" Property="Background" Value="#181818"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#007ACC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0098FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style (Blue) -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="BorderBrush" Value="#1177BB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1177BB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style (Red) -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#3E1E1E"/>
            <Setter Property="BorderBrush" Value="#6E2D2D"/>
            <Setter Property="Foreground" Value="#FF9999"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#802626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A82828"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#1E1E1E">
        <!-- 2D Viewport Canvas -->
        <Canvas x:Name="GameCanvas" Background="#181818" ClipToBounds="True"/>

        <!-- Top-Left Floating Panel: Create GameObject -->
        <Border x:Name="creategameobject"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,20,0,0" Width="260"
                Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8"
                Padding="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.45"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="✦ Create GameObject" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                <TextBlock Text="Name" FontSize="11" FontWeight="Medium" Foreground="#9E9E9E" Margin="0,0,0,4"/>
                <TextBox Name="GameObjectNameTextBox" Text="MyGameObject" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>

                <TextBlock Text="Type (Square / Circle)" FontSize="11" FontWeight="Medium" Foreground="#9E9E9E" Margin="0,0,0,4"/>
                <TextBox Name="GameObjectTypeTextBox" Text="Square" Style="{StaticResource DarkTextBox}" Margin="0,0,0,14"/>

                <Button Content="+ Create GameObject" Click="CreateGameObjectClick" Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Border>

        <!-- Bottom Docked Panel: Inspector -->
        <Border x:Name="inspector"
                VerticalAlignment="Bottom" Height="200"
                Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Direction="90" ShadowDepth="4" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Column 0: GameObject Details & Transform -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="INSPECTOR" FontSize="11" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="InsGOname" Text="Name: (none)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,12,0"/>
                        <TextBlock x:Name="InsGOtype" Text="Type: -" FontSize="13" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Size Controls -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Name="InsGOsize" Text="Size:" FontSize="12" Foreground="#A0A0A0" Width="55" VerticalAlignment="Center"/>
                        <TextBlock Text="W:" FontSize="11" Foreground="#707070" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBox Name="InsGOsizeIPX" Text="10" Width="45" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"/>
                        <TextBlock Text="H:" FontSize="11" Foreground="#707070" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBox Name="InsGOsizeIPY" Text="10" Width="45" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"/>
                        <Button Name="ApplyGONewSize" Click="ApplyGONewSizeClick" Content="Apply" Style="{StaticResource ModernButton}" Padding="8,3" FontSize="11"/>
                    </StackPanel>

                    <!-- Position Controls -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Name="InsGOposition" Text="Position:" FontSize="12" Foreground="#A0A0A0" Width="55" VerticalAlignment="Center"/>
                        <TextBlock Text="X:" FontSize="11" Foreground="#707070" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBox Name="InsGOPositionIPX" Text="0" Width="45" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"/>
                        <TextBlock Text="Y:" FontSize="11" Foreground="#707070" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBox Name="InsGOPositionIPY" Text="0" Width="45" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"/>
                        <Button Name="ApplyGONewPosition" Click="ApplyGONewPositionClick" Content="Apply" Style="{StaticResource ModernButton}" Padding="8,3" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Column 1: Vertical Divider -->
                <Rectangle Grid.Column="1" Fill="#3F3F46" Margin="0,6"/>

                <!-- Column 2: Components Section -->
                <Grid Grid.Column="2" Margin="24,0,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="COMPONENTS" FontSize="11" FontWeight="Bold" Foreground="#007ACC" VerticalAlignment="Center"/>
                        <Button Click="ComponentInfoClick" Content="ⓘ" Style="{StaticResource ModernButton}" Padding="6,1" FontSize="12" Margin="10,0,0,0" ToolTip="Component Information"/>
                    </StackPanel>

                    <!-- Current Components Display -->
                    <Border Grid.Row="1" Background="#1B1B1C" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="CurrentComponentsIns" Text="Current components: None" FontSize="12" Foreground="#D0D0D0" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Add / Remove Component Bar -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBox x:Name="AddCompTextBox" Text="rigidbody" Width="180" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"/>
                        <Button Click="AddComponentClick" Content="+ Add" Style="{StaticResource AccentButton}" Padding="12,5" Margin="0,0,8,0"/>
                        <Button Click="RemoveComponentClick" Content="- Remove" Style="{StaticResource DangerButton}" Padding="12,5"/>
                    </StackPanel>
                </Grid>

                <!-- Column 3: Exit Button -->
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                    <Button Content="Exit App" Click="ExitClick" Style="{StaticResource DangerButton}" Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
